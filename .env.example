# Media storage (local-disk driver). MEDIA_DIR is where uploaded/inbound binary
# attachments are written; MEDIA_MAX_BYTES caps upload + inbound media size.
MEDIA_DIR=".media"
MEDIA_MAX_BYTES="26214400"

# Time-based automation scheduler. Set AUTOMATION_CRON_SECRET to let an external
# cron POST to /api/automations/run-scheduled across all workspaces.
AUTOMATION_CRON_SECRET=""
AUTOMATION_TICK_SECONDS="60"
